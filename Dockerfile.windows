FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Set Salesforce CLI Environment Variables
# https://developer.salesforce.com/docs/atlas.en-us.sfdx_setup.meta/sfdx_setup/sfdx_dev_cli_env_variables.htm
ENV SF_AUTOUPDATE_DISABLE=true \
    SF_USE_GENERIC_UNIX_KEYCHAIN=true \
    SF_DOMAIN_RETRY=300 \
    SF_PROJECT_AUTOUPDATE_DISABLE_FOR_PACKAGE_CREATE=true \
    SF_PROJECT_AUTOUPDATE_DISABLE_FOR_PACKAGE_VERSION_CREATE=true \
    SF_DISABLE_DNS_CHECK=true \
    SF_DISABLE_SOURCE_MEMBER_POLLING=true \
    SF_HIDE_RELEASE_NOTES=true \
    SF_HIDE_RELEASE_NOTES_FOOTER=true \
    SF_SKIP_NEW_VERSION_CHECK=true \
    SF_CONTAINER_MODE=true \
    SF_CI_HEARTBEAT_FREQUENCY_MS=60000 \
    NODE_NO_WARNINGS=1

# Install Chocolatey, then Node.js LTS through it (tracks latest LTS the same
# way the Linux Dockerfile does via nodesource's setup_lts.x, instead of a
# hardcoded version that goes stale as plugins raise their minimum node)
RUN Set-ExecutionPolicy Bypass -Scope Process -Force; \
    [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; \
    Invoke-Expression ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1')); \
    choco install nodejs-lts -y --no-progress

# Refresh PATH for the RUN layers that follow (installers register PATH at machine level,
# but this shell process was already started before that write)
RUN $machinePath = [System.Environment]::GetEnvironmentVariable('Path', 'Machine'); \
    [System.Environment]::SetEnvironmentVariable('Path', $machinePath, 'Process')

# Install Salesforce CLI and plugins. Pinned to latest-rc, not latest, because
# @salesforce/cli@latest still bundles the broken @oclif/plugin-plugins@5.5.1
# (false "does not exist in the registry" on every `sf plugins install`);
# latest-rc already carries the fix. Switch back to @latest once that fix is
# promoted to GA - see https://github.com/oclif/plugin-plugins/issues/1387
RUN npm install --global npm@latest; \
    npm install --global @salesforce/cli@latest-rc; \
    echo y | sf plugins install sfdx-git-delta@^7.3.0; \
    echo y | sf plugins install apex-code-coverage-transformer@latest; \
    echo y | sf plugins install sf-package-list@latest; \
    echo y | sf plugins install apextestlist@^1.15.0; \
    sf version --verbose --json; \
    $global:LASTEXITCODE = 0
